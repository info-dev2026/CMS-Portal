{
  "info": {
    "name": "SAAPHZONE EV CMS - Telemetry & Testing Collection",
    "description": "Ready-to-use Postman collection for testing the SAAPHZONE EV Charger Telemetry Ingestion API, AC & DC charging sessions, battery connection states, and admin authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "cloudUrl",
      "value": "https://cms-backend-0bce.onrender.com",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "evc_live_0d975f1a5360db2917e90715",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Telemetry - AC Active Charging (11 kW, Battery Connected)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"apiKey\": \"{{apiKey}}\",\n  \"status\": \"CHARGING\",\n  \"charging_mode\": \"AC STANDARD\",\n  \"battery_connected\": true,\n  \"power_kw\": 11.0,\n  \"dc_voltage\": 380.5,\n  \"dc_current\": 28.9,\n  \"battery_soc\": 62.5,\n  \"battery_req_voltage\": 400.0,\n  \"battery_req_current\": 32.0,\n  \"charger_voltage\": 230.0,\n  \"charger_current\": 48.0,\n  \"session_energy_kwh\": 5.25,\n  \"session_duration_min\": 28.5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "telemetry"
          ]
        },
        "description": "Simulates active AC charging at 11 kW with battery connected. Sends real-time power_kw, DC voltage, DC current, and SOC."
      }
    },
